<?xml version="1.0" encoding="utf-8"?>
<sdf version="1.9">
  <model name="ptic_backdrop">
    <static>true</static>
    <link name="body">
      <visual name="rolling_hills">
        <pose>0 0 0 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry>
          <mesh>
            <uri>model://ptic_backdrop/meshes/hills.obj</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.21 0.33 0.2 1</ambient>
          <diffuse>0.21 0.33 0.2 1</diffuse>
          <specular>0.03 0.03 0.03 1</specular>
          <pbr>
            <metal>
              <roughness>1</roughness>
              <metalness>0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
      <visual name="forest_mass">
        <pose>0 0 0 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry>
          <mesh>
            <uri>model://ptic_backdrop/meshes/forest.obj</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.09775 0.2295 0.08075 1</ambient>
          <diffuse>0.09775 0.2295 0.08075 1</diffuse>
          <specular>0.03 0.03 0.03 1</specular>
          <pbr>
            <metal>
              <roughness>0.95</roughness>
              <metalness>0</metalness>
              <albedo_map>model://ptic_materials/textures/grass.png</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
